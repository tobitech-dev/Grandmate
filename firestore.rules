rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demo rules: owners can edit their own profile (including coins).
    // Before launch, move coin/rank changes to Cloud Functions and lock these down.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }
    match /names/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /queue/{uid} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null;
    }
    match /games/{gid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid in [request.resource.data.white, request.resource.data.black];
      allow update: if request.auth != null && request.auth.uid in [resource.data.white, resource.data.black];
    }
  }
}
